#define SECRET_WIFI_PASSWORD_1 "YOUR_WIFI_PASSWORD"

#define SECRET_WIFI_SSID_2 "Backup_WiFi_SSID"
#define SECRET_WIFI_PASSWORD_2 "Backup_WiFi_PASSWORD"

#define SECRET_ADMIN_USERNAME "admin"
#define SECRET_ADMIN_PASSWORD "admin123"
#endif
